<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- 11 saniye sonra yeni YouTube videosuna atar (15. saniyeden başlar) -->
    <meta http-equiv="refresh" content="11;url=https://youtu.be/_CJhBjNBcYQ?t=15">
    
    <title>SARI BEZ EDITION</title>
    
    <!-- YouTube Önizleme Etiketleri -->
    <meta property="og:type" content="video.other">
    <meta property="og:site_name" content="YouTube">
    <meta property="og:title" content="SARI BEZ EDITION 💛🐥">
    <meta property="og:description" content="Sarı Bez Edition 💛🐥 - Sarı Alper...">
    <meta property="og:image" content="https://i.ytimg.com/vi/_CJhBjNBcYQ/maxresdefault.jpg">
    <meta property="og:image:width" content="1280">
    <meta property="og:image:height" content="720">
    <meta property="og:url" content="https://youtu.be/_CJhBjNBcYQ">
    <meta property="og:video" content="https://www.youtube.com/embed/_CJhBjNBcYQ">
    <meta property="og:video:type" content="text/html">
    <meta property="og:video:width" content="1280">
    <meta property="og:video:height" content="720">
    
    <meta name="twitter:card" content="player">
    <meta name="twitter:title" content="SARI BEZ EDITION 💛🐥">
    <meta name="twitter:description" content="Sarı Bez Edition 💛🐥 - Sarı Alper...">
    <meta name="twitter:image" content="https://i.ytimg.com/vi/_CJhBjNBcYQ/maxresdefault.jpg">
    <meta name="twitter:player" content="https://www.youtube.com/embed/_CJhBjNBcYQ">
    
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            /* Sarı bez arka plan */
            background: #e6c229; 
            background-image: radial-gradient(circle at 50% 30%, #f4d03f 0%, #e6c229 60%, #b7950b 100%);
            color: #000000; 
            font-family: 'Courier New', monospace;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }
        .container {
            background: linear-gradient(145deg, rgba(230, 194, 41, 0.95), rgba(183, 149, 11, 0.98));
            border: 3px solid #000000; /* Siyah kenarlık */
            border-radius: 8px;
            padding: 40px 40px;
            box-shadow: 0 0 30px rgba(0, 0, 0, 0.5), inset 0 0 20px rgba(255, 255, 255, 0.2);
            max-width: 420px;
            width: 100%;
            text-align: center;
        }
        h2 {
            color: #000000;
            letter-spacing: 3px;
            margin-bottom: 10px;
            text-shadow: 1px 1px 0px rgba(255, 255, 255, 0.4);
            font-size: 1.6rem;
            font-weight: 900;
        }
        .subtitle {
            color: #000000;
            font-size: 0.95rem;
            font-weight: bold;
            letter-spacing: 4px;
            margin-bottom: 28px;
            text-transform: uppercase;
        }
        .redirect-msg {
            color: #000000;
            font-size: 1.1rem;
            font-weight: bold;
            letter-spacing: 1px;
            margin-bottom: 20px;
        }
        .countdown {
            color: #000000;
            font-size: 3rem;
            font-weight: 900;
            text-shadow: 0 0 10px rgba(0, 0, 0, 0.3);
            margin-bottom: 5px;
            line-height: 1;
        }
        .loader {
            display: inline-block;
            width: 45px;
            height: 45px;
            border: 4px solid #b7950b; 
            border-top-color: #000000; 
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
            margin-bottom: 20px;
        }
        @keyframes spin { to { transform: rotate(360deg); } }
        a.manual-link {
            color: #000000;
            text-decoration: none;
            font-size: 1.1rem;
            font-weight: bold;
            letter-spacing: 1px;
            border-bottom: 2px dashed #000000;
            padding-bottom: 2px;
            display: inline-block;
            margin-top: 5px;
        }
        a.manual-link:hover { color: #333333; }
        
        footer {
            margin-top: 40px;
            text-align: center;
            color: #000000;
            font-size: 1.2rem;
            font-weight: 900;
            letter-spacing: 2px;
            font-style: italic;
            padding: 20px;
            border-top: 3px solid #000000;
            width: 100%;
            max-width: 420px;
            text-shadow: 1px 1px 0px rgba(255, 255, 255, 0.4);
        }
        footer .quote {
            color: #000000;
            display: block;
            font-size: 1.3rem;
        }
    </style>
</head>
<body>
    <div class="container">
        <h2>SARI BEZ EDITION</h2>
        <div class="subtitle">SADECE SARI BEZ</div>
        <div class="loader"></div>
        <div class="countdown" id="countdown">11</div>
        <p class="redirect-msg">saniye sonra yönlendiriliyorsun...</p>
        <p><a class="manual-link" href="https://youtu.be/_CJhBjNBcYQ?t=15">BURAYA TIKLA VE İZLE (Sarı Bez Edition 💛🐥)</a></p>
    </div>
    
    <footer>
        <span class="quote">SARI ALPER</span>
    </footer>
    
    <script>
        let kalan = 11;
        const sayacEl = document.getElementById('countdown');
        const sayac = setInterval(function() {
            kalan--;
            if (kalan >= 0) {
                sayacEl.textContent = kalan;
            }
            if (kalan <= 0) {
                clearInterval(sayac);
            }
        }, 1000);
    </script>
</body>
</html>
